# Copy to .env and fill in your credentials
# Never commit this file to version control

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_google_api_key_here
YOUTUBE_CHANNEL_IDS=UCxxxxxx,UCyyyyyy
YOUTUBE_POLL_INTERVAL=60
YOUTUBE_MAX_RESULTS=50

# ── YouTube Comments ─────────────────────────────────────────────────────────
ENABLE_YOUTUBE_COMMENTS=false
YOUTUBE_COMMENTS_MAX_PER_VIDEO=0
YOUTUBE_COMMENTS_INCLUDE_REPLIES=true
YOUTUBE_COMMENTS_ORDER=time

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_STREAMER_LOGINS=streamer1,streamer2,streamer3
TWITCH_POLL_INTERVAL=30

# ── Twitch Chat ───────────────────────────────────────────────────────────────
ENABLE_TWITCH_CHAT=false
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_CHAT_OAUTH_TOKEN=oauth_token_here
TWITCH_CHAT_CHANNELS=streamer1,streamer2
TWITCH_CHAT_SERVER=irc.chat.twitch.tv
TWITCH_CHAT_PORT=6697
TWITCH_CHAT_USE_TLS=true

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://root:rootpassword@localhost:27017
MONGODB_DATABASE=social_raw

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/analytics
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline_password
POSTGRES_BATCH_SIZE=1000

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints/social-pipeline
SPARK_TRIGGER_INTERVAL=30 seconds
SPARK_MAX_OFFSETS_PER_TRIGGER=10000
